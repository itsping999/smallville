# OpenAI-compatible chat completions endpoint.
# Set LLM_BASE_URL to your provider's /v1 endpoint.
LLM_BASE_URL=http://112.5.167.211:58788/v1
LLM_API_KEY=sk-placeholder
LLM_MODEL=gpt5.5

# Optional: separate model for legacy Completion-style prompts.
# Defaults to LLM_MODEL when unset.
LLM_COMPLETION_MODEL=

# Set to 1 if your provider has no embeddings endpoint.
# Falls back to deterministic random vectors.
LLM_DISABLE_EMBEDDINGS=1
LLM_EMBEDDING_MODEL=text-embedding-ada-002

KEY_OWNER=local
DEBUG=True
